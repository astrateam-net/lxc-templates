/// hk.pkl — git-lifecycle gate for lxc-templates. Bypass: `HK=0 git commit …` / `--no-verify`
amends "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Builtins.pkl"

local hygiene = new Mapping<String, Step> {
  ["detect-private-key"]              = Builtins.detect_private_key
  ["check-merge-conflict"]            = Builtins.check_merge_conflict
  ["check-added-large-files"]         = Builtins.check_added_large_files
  ["check-case-conflict"]             = Builtins.check_case_conflict
  ["check-symlinks"]                  = Builtins.check_symlinks
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["trailing-whitespace"]             = Builtins.trailing_whitespace
  ["end-of-file"]                     = Builtins.newlines
  ["mixed-line-ending"]               = Builtins.mixed_line_ending
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["no-commit-to-main"] = Builtins.no_commit_to_branch
      ...hygiene
      ["shellcheck"] = new Step {
        glob = List("**/*.sh", "**/*.bash")
        check = "flint run shellcheck"
      }
      ["ryl"] = new Step {
        glob = List("**/*.yml", "**/*.yaml")
        fix = "flint run --fix --allow-fixed ryl"
      }
      ["rumdl"] = new Step {
        glob = List("**/*.md")
        fix = "flint run --fix --allow-fixed rumdl"
      }
      ["taplo"] = new Step {
        glob = List("**/*.toml")
        fix = "flint run --fix --allow-fixed taplo"
      }
      // Every images/<img>/manifest.yaml.tpl must assemble into valid YAML.
      ["render-check"] = new Step {
        glob = List("images/**")
        check = "mise run render-check"
      }
    }
  }

  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }

  ["check"] {
    steps {
      ...hygiene
      ["quality"] = new Step {
        check = "mise run check"
        exclusive = true
      }
    }
  }

  ["fix"] {
    fix = true
    steps {
      ...hygiene
    }
  }
}
